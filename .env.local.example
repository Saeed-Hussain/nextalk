# Copy this file to .env.local and fill in your Supabase project values
# (Project Settings -> API in the Supabase dashboard).
# NEXT_PUBLIC_ vars are exposed to the browser — that's expected here,
# the anon key is safe to expose because RLS policies protect your data.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary — cloud name and API key are safe to expose (they're not
# secrets), but the API secret must stay server-only. Get all three from
# Cloudinary Dashboard -> Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
